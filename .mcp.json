{
  "mcpServers": {
    "ludo": {
      "type": "http",
      "url": "https://mcp.ludo.ai/mcp",
      "headers": {
        "Authorization": "ApiKey ${LUDO_API_KEY}"
      }
    },
    "tripo": {
      "command": "uvx",
      "args": ["tripo-mcp"],
      "env": {
        "TRIPO_API_KEY": "${TRIPO_API_KEY}"
      }
    }
  }
}
